<section>
  <h1>Real Time Products</h1>

  <form id="productForm" class="filters">
    <label>Título<input name="title" required /></label>
    <label>Descripción<input name="description" required /></label>
    <label>Código<input name="code" required /></label>
    <label>Precio<input name="price" type="number" min="0" required /></label>
    <label>Stock<input name="stock" type="number" min="0" required /></label>
    <label>Categoría<input name="category" required /></label>
    <label>Status
      <select name="status">
        <option value="true">true</option>
        <option value="false">false</option>
      </select>
    </label>
    <label>Thumbnail<input name="thumbnails" /></label>
    <button type="submit">Agregar producto</button>
  </form>

  <p id="socketMessage"></p>

  <div id="realtimeList" class="grid">
    {{#each products}}
      <article class="card">
        <h2>{{this.title}}</h2>
        <p><strong>Precio:</strong> ${{this.price}}</p>
        <p><strong>Categoría:</strong> {{this.category}}</p>
        <button class="button danger delete-product" data-id="{{this._id}}">Eliminar</button>
      </article>
    {{/each}}
  </div>
</section>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/realtime.js"></script>
