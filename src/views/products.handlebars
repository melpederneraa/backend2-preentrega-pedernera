<section>
  <h1>Productos</h1>

  <form method="GET" action="/products" class="filters">
    <input type="hidden" name="cid" value="{{cartId}}" />
    <label>
      Categoría o status
      <input type="text" name="query" placeholder="ej: notebooks o true" value="{{query}}" />
    </label>
    <label>
      Orden por precio
      <select name="sort">
        <option value="" {{#if (eq sort "")}}selected{{/if}}>Sin orden</option>
        <option value="asc" {{#if (eq sort "asc")}}selected{{/if}}>Ascendente</option>
        <option value="desc" {{#if (eq sort "desc")}}selected{{/if}}>Descendente</option>
      </select>
    </label>
    <label>
      Límite
      <input type="number" name="limit" min="1" value="{{limit}}" />
    </label>
    <button type="submit">Aplicar</button>
    <a class="button secondary" href="/carts/{{cartId}}">Ver carrito</a>
  </form>

  {{#if hasProducts}}
    <div class="grid">
      {{#each products}}
        <article class="card">
          <h2>{{this.title}}</h2>
          <p><strong>Categoría:</strong> {{this.category}}</p>
          <p><strong>Precio:</strong> ${{this.price}}</p>
          <p><strong>Stock:</strong> {{this.stock}}</p>
          <div class="actions">
            <a class="button" href="/products/{{this._id}}?cid={{../cartId}}">Ver detalle</a>
            <button class="button add-to-cart" data-cart-id="{{../cartId}}" data-product-id="{{this._id}}">Agregar al carrito</button>
          </div>
        </article>
      {{/each}}
    </div>
  {{else}}
    <p>No hay productos para mostrar.</p>
  {{/if}}

  <div class="pagination">
    {{#if hasPrevPage}}
      <a class="button secondary" href="{{prevLink}}">Página anterior</a>
    {{/if}}
    <span>Página {{page}} de {{totalPages}}</span>
    {{#if hasNextPage}}
      <a class="button secondary" href="{{nextLink}}">Página siguiente</a>
    {{/if}}
  </div>
</section>

<script src="/js/products.js"></script>
